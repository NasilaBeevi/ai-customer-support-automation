    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a customer support email classification assistant.\n\nAnalyse the customer email below:\n\n{{ $json.email_message }}\n\nReturn only a valid JSON object with these five fields:\n- \"issue_summary\": a short summary of the problem\n- \"suggested_department\": one of \"Delivery\", \"Billing\", \"Technical Support\", or \"General Support\"\n- \"order_number\": the order number provided in the email, or null if missing\n- \"human_review_required\": true or false\n- \"review_reason\": explain why human review is needed, or an empty string if it is not needed\n\nRules:\n1. Never invent missing information.\n2. If the order number is missing for a delivery issue, set human_review_required to true.\n3. If the issue is unclear, set human_review_required to true.\n4. Otherwise, set human_review_required to false.\n5. Return JSON only, with no Markdown code fences or extra commentary.",
        "hasOutputParser": true,
        "batching": {}
      },
      "id": "27f78fd1-aa4f-4beb-a06d-56f14cfb4bbf",
      "name": "Basic LLM Chain",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        448,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "claude-sonnet-5",
          "cachedResultName": "Claude Sonnet 5"
        },
        "options": {}
      },
      "id": "387c5d2a-9633-445b-bcc2-56a6e006061e",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.6,
      "position": [
        384,
        208
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst results = [];\n\nfor (const item of $input.all()) {\n  const raw = item.json.text;\n\n  if (typeof raw !== 'string') {\n    throw new Error('Expected AI output in the text field.');\n  }\n\n  // Remove optional Markdown code fences\n  const cleaned = raw\n    .trim()\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/, '');\n\n  let parsed;\n\n  try {\n    parsed = JSON.parse(cleaned);\n  } catch (error) {\n    throw new Error(\n      'AI output is not valid JSON. Actual output: ' + raw\n    );\n  }\n\n  const requiredFields = [\n    'issue_summary',\n    'suggested_department',\n    'order_number',\n    'human_review_required',\n    'review_reason'\n  ];\n\n  for (const field of requiredFields) {\n    if (!(field in parsed)) {\n      throw new Error(`Missing required field: ${field}`);\n    }\n  }\n\n  if (typeof parsed.human_review_required !== 'boolean') {\n    throw new Error('human_review_required must be true or false.');\n  }\n\n  results.push({\n    json: {\n      issue_summary: parsed.issue_summary,\n      suggested_department: parsed.suggested_department,\n      order_number: parsed.order_number,\n      human_review_required: parsed.human_review_required,\n      review_reason: parsed.review_reason\n    }\n  });\n}\n\nreturn results;\n"
      },
